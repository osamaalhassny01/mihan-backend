APP_NAME="مِهَن - MIHAN"
APP_URL=http://localhost/mihan
APP_ENV=development

DB_HOST=localhost
DB_NAME=mihan
DB_USER=root
DB_PASS=

AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# مفتاح تشفير الذكاء الاصطناعي (AES-256-GCM): يتم توليده وحفظه تلقائيًا عند تشغيل التطبيق لأول مرة إن لم يكن محددًا
AI_ENCRYPTION_KEY=

# Firebase HTTP v1: service account JSON from the SAME Firebase project as the app.
# Railway: set FCM_SERVICE_ACCOUNT_JSON as a secret environment variable (whole JSON).
FCM_SERVICE_ACCOUNT_JSON=
# Alternatively mount the JSON file outside the public web root and set its absolute path.
GOOGLE_APPLICATION_CREDENTIALS=
